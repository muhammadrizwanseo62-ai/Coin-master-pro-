// Database connection
const connectDB = async () => {
    try {
        const conn = await mongoose.connect(process.env.MONGODB_URI, {
            useNewUrlParser: true,
            useUnifiedTopology: true,
        });
        
        console.log(`✅ MongoDB Connected: ${conn.connection.host}`);
        console.log(`✅ Database: ${conn.connection.name}`);
        
        // Create default admin if none exists - USING YOUR ADMIN CREDENTIALS
        const Admin = require('./models/Admin');
        const adminCount = await Admin.countDocuments();
        
        if (adminCount === 0) {
            const bcrypt = require('bcryptjs');
            const salt = await bcrypt.genSalt(parseInt(process.env.BCRYPT_ROUNDS) || 10);
            const hashedPassword = await bcrypt.hash(process.env.ADMIN_PASSWORD, salt);
            
            await Admin.create({
                username: process.env.ADMIN_USERNAME || 'admin',
                email: process.env.ADMIN_EMAIL || 'admin@example.com',
                password: hashedPassword,
                fullName: 'Super Admin',
                role: 'super_admin',
                phone: process.env.ADMIN_PHONE,
                telegramId: process.env.ADMIN_TELEGRAM_ID,
                telegramUsername: process.env.ADMIN_TELEGRAM_USERNAME,
                permissions: [
                    'manage_ads',
                    'manage_inline_ads',
                    'manage_users',
                    'manage_tasks',
                    'manage_withdrawals',
                    'view_analytics',
                    'manage_admins',
                    'export_data',
                    'import_data',
                    'update_settings'
                ],
                status: 'active'
            });
            
            console.log('✅ Default admin created:');
            console.log(`   Username: ${process.env.ADMIN_USERNAME}`);
            console.log(`   Password: [HIDDEN - see .env file]`);
            console.log(`   ⚠️ Please change this password in production!`);
        }
        
    } catch (error) {
        console.error('❌ Database connection error:', error);
        process.exit(1);
    }
};

